---
import AuditCta from '../components/AuditCta.astro';
import FeeCalculator from '../components/FeeCalculator.astro';
import PageIntro from '../components/PageIntro.astro';
import { contact, includedInEveryPlan, planDetails, pricingFaqs, pricingTerms } from '../data/site';
import Base from '../layouts/Base.astro';
import { plans } from '../lib/pricing';

const gbp = (n: number) => `£${n.toLocaleString('en-GB')}`;
const recommended = 'growth';
---

<Base
  title="Pricing"
  description="Published flat fees for profit-led paid media. Never a percentage of your ad spend. Four senior people on every account, from Starter up."
>
  <PageIntro eyebrow="Pricing" title="One fee. Published. No percentage of spend.">
    <p>
      Most London agencies quote on request, then take 10–20% of your ad spend. We publish a flat
      monthly fee tied to your spend band, so you know the cost before the first call and we never
      gain from you spending more.
    </p>
  </PageIntro>

  <section class="section plans-section">
    <div class="wrap">
      <ul class="plans">
        {
          plans.map((plan, i) => {
            const details = planDetails[plan.id];
            const isRecommended = plan.id === recommended;
            return (
              <li class:list={['plan', 'reveal', { 'plan--recommended': isRecommended }]}>
                <div class="plan__top">
                  <span class="mono">0{i + 1}</span>
                  {isRecommended && <span class="plan__badge">Most clients choose</span>}
                </div>
                <span class="plan__symbol" aria-hidden="true">{details.symbol}</span>
                <h2 class="plan__name">{plan.name}</h2>
                <p class="plan__summary">{details.summary}</p>
                <p class="plan__price">
                  <span class="plan__from">from</span>
                  <span class="figure">{gbp(plan.monthlyFee)}</span>
                  <span class="plan__per">/month</span>
                </p>
                <dl class="plan__facts">
                  <div>
                    <dt>Ad spend</dt>
                    <dd class="mono">up to {gbp(plan.spendCap)}/mo</dd>
                  </div>
                  <div>
                    <dt>Meetings</dt>
                    <dd>{plan.meetings}</dd>
                  </div>
                </dl>
                <ul class="plan__features">
                  {details.features.map((feature) => <li>{feature}</li>)}
                </ul>
                <a class:list={['btn', isRecommended ? 'btn--primary' : 'btn--ghost']} href={`mailto:${contact.email}?subject=${encodeURIComponent(`${plan.name} plan`)}`}>
                  Talk to us about {plan.name} <span class="arrow">→</span>
                </a>
              </li>
            );
          })
        }
      </ul>

      <p class="custom reveal">
        <span>
          Spending more than {gbp(pricingTerms.customAbove)} a month? We’ll build a plan around you.
        </span>
        <a class="link" href={`mailto:${contact.email}?subject=${encodeURIComponent('Custom plan')}`}>{contact.email}</a>
      </p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap included">
      <div class="section-head reveal">
        <span class="eyebrow">Every plan</span>
        <h2 class="heading-m">What’s included, from Starter up.</h2>
      </div>
      <ul class="included__list reveal">
        {includedInEveryPlan.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="wrap terms reveal">
      <div>
        <span class="figure">{pricingTerms.startMonths}</span>
        <p>month start, then rolling monthly</p>
      </div>
      <div>
        <span class="figure">{pricingTerms.reviewDays}</span>
        <p>days to show profit gains, or we say so first</p>
      </div>
      <div>
        <span class="figure">{gbp(pricingTerms.onboardingFrom)}</span>
        <p>one-off onboarding and tracking setup, from</p>
      </div>
      <div>
        <span class="figure">{gbp(pricingTerms.minimumSpend)}</span>
        <p>minimum monthly ad spend</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Do the maths</span>
        <h2 class="heading-l">What a percentage agency would charge you.</h2>
        <p class="lede">
          Move the slider to your monthly ad spend. Above the Starter band, the flat fee is almost always
          the better deal, and the gap widens as you grow.
        </p>
      </div>
      <div class="reveal">
        <FeeCalculator />
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap faq">
      <div class="section-head reveal">
        <span class="eyebrow">Questions</span>
        <h2 class="heading-m">The things London buyers ask us first.</h2>
      </div>
      <div class="faq__list">
        {
          pricingFaqs.map((faq) => (
            <details class="reveal">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <AuditCta />
</Base>

<style>
  .plans-section {
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    border: 1.5px solid var(--ink);
    background: var(--paper);
  }

  .plan--recommended {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
    box-shadow: 0 30px 60px -35px rgb(0 0 0 / 0.6);
  }

  .plan__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 1.6rem;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .plan--recommended .plan__top {
    color: #9a9a9a;
  }

  .plan__badge {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--magenta);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--magenta);
  }

  .plan__symbol {
    font-size: clamp(3.5rem, 6vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .plan__name {
    font-size: var(--step-2);
  }

  .plan__summary {
    color: var(--muted);
    min-height: 3.2em;
  }

  .plan--recommended .plan__summary {
    color: #b0b0b0;
  }

  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
  }

  .plan--recommended .plan__price {
    border-color: #2a2a2a;
  }

  .plan__price .figure {
    font-size: clamp(2.2rem, 3.6vw, 3rem);
  }

  .plan--recommended .plan__price .figure {
    color: var(--magenta);
  }

  .plan__from,
  .plan__per {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .plan--recommended .plan__from,
  .plan--recommended .plan__per {
    color: #9a9a9a;
  }

  .plan__facts {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .plan__facts div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.92rem;
  }

  .plan__facts dt {
    color: var(--muted);
  }

  .plan--recommended .plan__facts dt {
    color: #9a9a9a;
  }

  .plan__facts dd {
    margin: 0;
  }

  .plan__features {
    display: grid;
    gap: 0.55rem;
    margin: 0.5rem 0 1.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.95rem;
  }

  .plan__features li {
    position: relative;
    padding-left: 1.4rem;
  }

  .plan__features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.55rem;
    height: 0.55rem;
    border: 1.5px solid currentColor;
  }

  .plan .btn {
    margin-top: auto;
    justify-content: center;
  }

  .plan--recommended .btn--ghost {
    --btn-fg: var(--paper);
  }

  .custom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px dashed var(--line-strong);
  }

  @media (max-width: 64rem) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
    }

    .plan__summary {
      min-height: 0;
    }
  }

  .included {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 3rem;
    align-items: start;
  }

  .included__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }

  .included__list li {
    padding: 1.1rem 1rem 1.1rem 0;
    border-bottom: 1px solid var(--line-strong);
    font-size: 1.05rem;
  }

  .terms {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--ink);
  }

  .terms > div {
    display: grid;
    gap: 0.6rem;
    padding: 1.5rem 1.5rem 0 0;
  }

  .terms > div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line-strong);
  }

  .terms .figure {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
  }

  .terms p {
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 52rem) {
    .included {
      grid-template-columns: minmax(0, 1fr);
    }

    .included__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .terms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2rem;
    }

    .terms > div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
  }

  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 3rem;
    align-items: start;
  }

  .faq__list {
    border-top: 1px solid var(--ink);
  }

  details {
    border-bottom: 1px solid var(--line-strong);
  }

  summary {
    position: relative;
    padding: 1.4rem 3rem 1.4rem 0;
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.02em;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    position: absolute;
    right: 0.25rem;
    top: 50%;
    translate: 0 -50%;
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 400;
    transition: rotate 0.25s var(--ease);
  }

  details[open] summary::after {
    rotate: 45deg;
    color: var(--magenta-ink);
  }

  details p {
    max-width: 40rem;
    padding-bottom: 1.5rem;
    color: var(--muted);
  }

  @media (max-width: 52rem) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
