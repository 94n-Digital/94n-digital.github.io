---
const count = 60;
const margins = Array.from({ length: count }, (_, i) =>
  Math.round(2900 * Math.exp(-i / 4.2) - 300 - 170 * Math.abs(Math.sin(i * 1.7)) + i * 1.5),
);

const losers = margins.filter((m) => m < 0);
const lossTotal = -losers.reduce((sum, m) => sum + m, 0);
const firstLoser = margins.findIndex((m) => m < 0);
const max = Math.max(...margins);
const min = Math.min(...margins);

const width = 960;
const height = 300;
const pad = 8;
const zeroY = pad + ((height - 2 * pad) * max) / (max - min);
const scale = (height - 2 * pad) / (max - min);
const slot = width / count;
const barWidth = slot * 0.62;
const lossStartX = firstLoser * slot;
---

<figure class="curve">
  <div class="curve__stats">
    <div>
      <span class="curve__label">Blended ROAS</span>
      <span class="figure curve__stat">4.1×</span>
      <span class="curve__hint">Looks healthy</span>
    </div>
    <div>
      <span class="curve__label">Products losing money</span>
      <span class="figure curve__stat accent">{losers.length}<small>/{count}</small></span>
      <span class="curve__hint">−£{lossTotal.toLocaleString('en-GB')} a month, hidden in the average</span>
    </div>
  </div>

  <svg
    viewBox={`0 0 ${width} ${height + 40}`}
    role="img"
    aria-label={`Illustrative chart of ${count} products sorted by contribution margin. ${firstLoser} products make money; ${losers.length} lose it.`}
  >
    <line x1="0" x2={width} y1={zeroY} y2={zeroY} class="axis"></line>
    {
      margins.map((m, i) => {
        const h = Math.max(1, Math.abs(m) * scale);
        return (
          <rect
            class:list={['bar', { 'bar--loss': m < 0 }]}
            style={`--i:${i}`}
            x={i * slot + (slot - barWidth) / 2}
            y={m >= 0 ? zeroY - h : zeroY}
            width={barWidth}
            height={h}
          />
        );
      })
    }
    <path
      class="bracket"
      d={`M${lossStartX + 2} ${height + 14} v8 H${width - 2} v-8`}
      fill="none"
    ></path>
    <text x={lossStartX + 4} y={height + 38} class="bracket__label">
      The long tail: spending money to lose money
    </text>
    <text x={lossStartX + 14} y="22" class="bracket__label bracket__label--muted">
      ← The few carrying the account
    </text>
  </svg>
  <figcaption class="illustrative">Illustrative: 60 products sorted by monthly contribution margin after ad spend.</figcaption>
</figure>

<style>
  .curve {
    margin: 0;
    display: grid;
    gap: 2rem;
  }

  .curve__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
  }

  .curve__stats > div {
    display: grid;
    gap: 0.4rem;
    padding: 1.25rem 0;
  }

  .curve__stats > div + div {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .curve__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .curve__stat {
    font-size: clamp(2.6rem, 6vw, 4.5rem);
  }

  .curve__stat small {
    font-size: 0.4em;
    color: var(--faint);
    letter-spacing: 0;
  }

  .curve__hint {
    font-size: 0.92rem;
    color: var(--muted);
  }

  svg {
    width: 100%;
    overflow: visible;
  }

  .axis {
    stroke: var(--ink);
    stroke-width: 1;
  }

  .bar {
    fill: var(--ink);
    transform-box: fill-box;
    transform-origin: bottom;
  }

  .bar--loss {
    fill: #c9c9c4;
    transform-origin: top;
  }

  .bracket {
    stroke: var(--magenta);
    stroke-width: 2;
  }

  .bracket__label {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--magenta-ink);
  }

  .bracket__label--muted {
    fill: var(--muted);
  }

  @media (max-width: 40rem) {
    .bracket__label {
      font-size: 22px;
    }

    .bracket__label--muted {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .bar {
        animation: grow linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 40%;
      }
    }
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }
</style>
