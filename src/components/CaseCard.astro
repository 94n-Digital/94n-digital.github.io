---
import type { CaseStudy } from '../data/site';

interface Props {
  study: CaseStudy;
  detailed?: boolean;
}

const { study, detailed = false } = Astro.props;
---

<article class:list={['case', { 'case--detailed': detailed }]}>
  <div class="case__top">
    <span>{study.number}</span>
    <span>{study.sector}{study.uk && ' · UK'}</span>
  </div>
  <span class="case__symbol" aria-hidden="true">{study.symbol}</span>
  <p class="case__figure figure">{study.headline}</p>
  <div class="case__meta">
    <h3 class="case__client">{study.client}</h3>
    <p class="case__measure">
      {study.measure}{study.period && <>, <span>{study.period.toLowerCase()}</span></>}
    </p>
  </div>
  {detailed && <p class="case__context">{study.context}</p>}
</article>

<style>
  .case {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    gap: 0.75rem;
    min-height: 22rem;
    padding: 1.4rem;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    transition:
      transform 0.35s var(--ease),
      border-color 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .case:hover {
    transform: translateY(-4px);
    border-color: var(--magenta);
    box-shadow: 0 22px 50px -30px rgb(255 27 191 / 0.55);
  }

  .case__top {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .case__symbol {
    font-size: clamp(3.5rem, 6vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--line-strong);
    transition: color 0.35s var(--ease);
  }

  .case:hover .case__symbol {
    color: var(--magenta);
  }

  .case__figure {
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    white-space: nowrap;
  }

  .case__meta {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .case__client {
    font-size: 1.05rem;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .case__measure {
    font-size: 0.88rem;
    color: var(--muted);
  }

  .case__context {
    color: var(--ink-2);
    font-size: 0.98rem;
  }

  .case--detailed {
    min-height: 0;
  }
</style>
